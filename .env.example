# mock needs no API key. Real calls send the project idea to the chosen provider.
APP_PROVIDER=mock # mock | gemini
APP_DECIDER=mock  # mock | jev
APP_GEMINI_API_KEY=
APP_GEMINI_MODEL=gemini-3.5-flash-lite
# opencode: free for a limited time with a usage cap. Use invented inputs only.
# vercel: needs paid AI Gateway credits; requests require zero data retention.
# typesafe: paid direct API at api.typesafe.ai; key from the TypeSafe console.
APP_JEV_ROUTE=opencode # opencode | vercel | typesafe
APP_JEV_MODEL=
APP_OPENCODE_API_KEY=
APP_AI_GATEWAY_API_KEY=
APP_TYPESAFE_API_KEY=
# owner shows links to the note owner's private lecture notes. Keep none for anyone else.
APP_EVIDENCE_SCOPE=none
APP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Local Compose only. Set your own values in .env for anything beyond this machine.
POSTGRES_PASSWORD=starter-local-only
POSTGRES_PORT=5432
# Used when the backend runs outside Compose; Compose sets its own.
APP_DATABASE_URL=postgresql://starter:starter-local-only@127.0.0.1:5432/starter
